#!/usr/bin/env bash
# powermode: switch CPU, RAPL and GPU power caps between silent, default and turbo.
#
#   powermode [--force] silent|default|turbo   apply a mode (root) and record it; a mode that is
#                                              already recorded and live-verified is left alone
#                                              ("already MODE"), --force applies it anyway
#   powermode boot                  re-apply the recorded mode (powermode.service)
#   powermode status                show the recorded mode and a live readout (any user)
#
# Every apply and boot holds an flock on $ROOT/run/powermode.lock; a second run waits for the
# first (POWERMODE_LOCK_TIMEOUT seconds, default 60, then fails).
#
# Test hooks: POWERMODE_SYSFS_ROOT is prefixed to every /sys, /run and /var/lib path,
# POWERMODE_NVIDIA_SMI replaces the nvidia-smi binary.
set -euo pipefail

ROOT=${POWERMODE_SYSFS_ROOT:-}
NVSMI=${POWERMODE_NVIDIA_SMI:-nvidia-smi}

PSTATE_DIR=$ROOT/sys/devices/system/cpu/intel_pstate
CPU_DIR=$ROOT/sys/devices/system/cpu
RAPL_DIR=$ROOT/sys/class/powercap/intel-rapl:0
MODE_FILE=$ROOT/var/lib/powermode/mode
STATE_FILE=$ROOT/run/powermode
LOCK_FILE=$ROOT/run/powermode.lock
LOCK_TIMEOUT=${POWERMODE_LOCK_TIMEOUT:-60}
GPU_LIMITS=index,power.min_limit,power.default_limit,power.max_limit

FAILED=0
FORCE=0

usage() {
  echo "usage: powermode [--force] silent|default|turbo|boot|status" >&2
}

warn() {
  echo "powermode: warning: $*" >&2
  FAILED=1
}

# write_sysfs VALUE PATH: a failed write warns and marks the run failed; the run goes on.
write_sysfs() {
  { printf '%s\n' "$1" > "$2"; } 2>/dev/null || warn "cannot write $1 to $2"
}

# write_sysfs_quiet VALUE PATH: a write the kernel may refuse; a refusal is not reported.
write_sysfs_quiet() {
  { printf '%s\n' "$1" > "$2"; } 2>/dev/null || true
}

# read_value PATH: first line of a file, or ? when it cannot be read.
read_value() {
  local value=""
  value=$(head -n 1 "$1" 2>/dev/null) || true
  printf '%s\n' "${value:-?}"
}

# read_watts PATH: a RAPL limit in microwatts shown as whole watts, or ?.
read_watts() {
  local value
  value=$(read_value "$1")
  if [[ $value =~ ^[0-9]+$ ]]; then
    printf '%s\n' "$(( value / 1000000 ))"
  else
    printf '?\n'
  fi
}

# whole_number VALUE: nvidia-smi prints watts as 150.00; keep the integer part.
whole_number() {
  local value=${1//[[:space:]]/}
  printf '%s\n' "${value%%.*}"
}

# run_smi ARGS...: a failed nvidia-smi call warns and marks the run failed; the run goes on.
run_smi() {
  if ! "$NVSMI" "$@" >/dev/null 2>&1; then
    warn "nvidia-smi $* failed"
  fi
}

# gpu_clock_ceiling INDEX: the silent-mode graphics clock ceiling in MHz, empty if none.
gpu_clock_ceiling() {
  case $1 in
    0) printf '%s\n' 1800 ;;
    1) printf '%s\n' 1600 ;;
    *) printf '\n' ;;
  esac
}

# apply_gpus LIMIT CLOCKS: LIMIT is min, default or max; CLOCKS is silent (lock the clock
# ceiling) or reset (release any locked clocks).
apply_gpus() {
  local limit_kind=$1 clocks=$2 query idx lo def hi limit ceiling
  if ! query=$("$NVSMI" --query-gpu="$GPU_LIMITS" --format=csv,noheader,nounits 2>/dev/null); then
    warn "nvidia-smi could not list the GPUs"
    return 0
  fi
  while IFS=, read -r idx lo def hi; do
    idx=${idx//[[:space:]]/}
    [[ $idx =~ ^[0-9]+$ ]] || continue
    lo=$(whole_number "$lo")
    def=$(whole_number "$def")
    hi=$(whole_number "$hi")
    case $limit_kind in
      min) limit=$lo ;;
      default) limit=$def ;;
      max) limit=$hi ;;
    esac
    run_smi -i "$idx" -pl "$limit"
    if [[ $clocks == silent ]]; then
      ceiling=$(gpu_clock_ceiling "$idx")
      if [[ -n $ceiling ]]; then
        run_smi -i "$idx" -lgc "210,$ceiling"
      fi
    else
      run_smi -i "$idx" -rgc
    fi
  done <<< "$query"
}

# apply_rapl PL1 PL2: long-term and short-term package power limits, in watts.
apply_rapl() {
  write_sysfs "$(( $1 * 1000000 ))" "$RAPL_DIR/constraint_0_power_limit_uw"
  write_sysfs "$(( $2 * 1000000 ))" "$RAPL_DIR/constraint_1_power_limit_uw"
}

# apply_cpu NO_TURBO MAX_PERF GOVERNOR EPP [quiet]: governor is set before EPP on each CPU.
# With "quiet" a refused EPP write is not reported (the performance governor refuses it).
apply_cpu() {
  local no_turbo=$1 max_perf=$2 governor=$3 epp=$4 quiet=${5:-} dir found=0
  write_sysfs "$no_turbo" "$PSTATE_DIR/no_turbo"
  write_sysfs "$max_perf" "$PSTATE_DIR/max_perf_pct"
  for dir in "$CPU_DIR"/cpu[0-9]*/cpufreq; do
    if [[ ! -d $dir ]]; then
      continue
    fi
    found=1
    write_sysfs "$governor" "$dir/scaling_governor"
    if [[ -n $quiet ]]; then
      write_sysfs_quiet "$epp" "$dir/energy_performance_preference"
    else
      write_sysfs "$epp" "$dir/energy_performance_preference"
    fi
  done
  (( found )) || warn "no cpufreq directories under $CPU_DIR"
}

# record_mode MODE: remember the mode for boot (/var/lib) and for the i3bar (/run).
record_mode() {
  mkdir -p "$(dirname "$MODE_FILE")" "$(dirname "$STATE_FILE")" \
    && printf '%s\n' "$1" > "$MODE_FILE" \
    && printf '%s\n' "$1" > "$STATE_FILE" \
    && chmod 0644 "$MODE_FILE" "$STATE_FILE" \
    || warn "cannot record mode $1"
}

# take_lock: hold LOCK_FILE for the rest of the run; a run waits up to LOCK_TIMEOUT seconds.
take_lock() {
  if ! { mkdir -p "$(dirname "$LOCK_FILE")" && exec 9>>"$LOCK_FILE"; } 2>/dev/null; then
    echo "powermode: cannot open $LOCK_FILE" >&2
    exit 1
  fi
  if ! flock -w "$LOCK_TIMEOUT" 9; then
    echo "powermode: another run still holds $LOCK_FILE after ${LOCK_TIMEOUT}s; giving up" >&2
    exit 1
  fi
}

# within_one A B: two whole-watt (or whole-number) readings differ by at most 1. A non-number is no.
within_one() {
  [[ $1 =~ ^[0-9]+$ && $2 =~ ^[0-9]+$ ]] || return 1
  local diff=$(( $1 - $2 ))
  (( diff >= -1 && diff <= 1 ))
}

# gpus_match KIND: every GPU's live power limit is within 1 W of its min, default or max limit.
# Reads only. No GPUs listed counts as no match, so the mode is applied.
gpus_match() {
  local kind=$1 query current idx lo def hi want cur seen=0
  local -A wanted=()
  query=$("$NVSMI" --query-gpu="$GPU_LIMITS" --format=csv,noheader,nounits 2>/dev/null) || return 1
  while IFS=, read -r idx lo def hi; do
    idx=${idx//[[:space:]]/}
    [[ $idx =~ ^[0-9]+$ ]] || continue
    case $kind in
      min) want=$(whole_number "$lo") ;;
      default) want=$(whole_number "$def") ;;
      max) want=$(whole_number "$hi") ;;
    esac
    wanted[$idx]=$want
  done <<< "$query"
  (( ${#wanted[@]} > 0 )) || return 1
  current=$("$NVSMI" --query-gpu=index,power.limit --format=csv,noheader,nounits 2>/dev/null) || return 1
  while IFS=, read -r idx cur; do
    idx=${idx//[[:space:]]/}
    [[ $idx =~ ^[0-9]+$ ]] || continue
    [[ -n ${wanted[$idx]:-} ]] || return 1
    cur=$(whole_number "$cur")
    within_one "$cur" "${wanted[$idx]}" || return 1
    seen=$((seen + 1))
  done <<< "$current"
  (( seen == ${#wanted[@]} ))
}

# settings_match MODE: the live no_turbo, max_perf_pct, RAPL limits and GPU power limits all match
# MODE. Reads only; any unreadable value counts as a mismatch.
settings_match() {
  local no_turbo max_perf pl1 pl2 gpu_kind
  case $1 in
    silent) no_turbo=1; max_perf=60; pl1=65; pl2=90; gpu_kind=min ;;
    default) no_turbo=0; max_perf=100; pl1=125; pl2=190; gpu_kind=default ;;
    turbo) no_turbo=0; max_perf=100; pl1=190; pl2=190; gpu_kind=max ;;
    *) return 1 ;;
  esac
  [[ $(read_value "$PSTATE_DIR/no_turbo") == "$no_turbo" ]] || return 1
  [[ $(read_value "$PSTATE_DIR/max_perf_pct") == "$max_perf" ]] || return 1
  within_one "$(read_watts "$RAPL_DIR/constraint_0_power_limit_uw")" "$pl1" || return 1
  within_one "$(read_watts "$RAPL_DIR/constraint_1_power_limit_uw")" "$pl2" || return 1
  gpus_match "$gpu_kind"
}

# recorded_mode: the mode in MODE_FILE, or an empty line when it is missing or not a known mode.
recorded_mode() {
  local mode=""
  mode=$(head -n 1 "$MODE_FILE" 2>/dev/null) || mode=""
  case $mode in
    silent|default|turbo) printf '%s\n' "$mode" ;;
    *) printf '\n' ;;
  esac
}

# apply_requested MODE: skip the writes when MODE is recorded and the live settings already match
# (so repeating a mode leaves identical state); otherwise apply it. --force always applies.
apply_requested() {
  local mode=$1
  if (( FORCE == 0 )) && [[ $(recorded_mode) == "$mode" ]] && settings_match "$mode"; then
    echo "already $mode"
    return 0
  fi
  apply_mode "$mode"
}

apply_mode() {
  local mode=$1
  run_smi -pm 1
  case $mode in
    silent)
      apply_gpus min silent
      apply_rapl 65 90
      apply_cpu 1 60 powersave power
      ;;
    default)
      apply_gpus default reset
      apply_rapl 125 190
      apply_cpu 0 100 powersave balance_performance
      ;;
    turbo)
      apply_gpus max reset
      apply_rapl 190 190
      apply_cpu 0 100 performance performance quiet
      ;;
  esac
  if (( FAILED == 0 )); then
    record_mode "$mode"
  else
    echo "powermode: $mode applied with errors; recorded mode unchanged" >&2
  fi
}

boot_mode() {
  local mode=""
  mode=$(head -n 1 "$MODE_FILE" 2>/dev/null) || true
  case $mode in
    silent|default|turbo) ;;
    *) mode=silent ;;
  esac
  echo "powermode: boot: applying $mode"
  apply_mode "$mode"
}

show_status() {
  local query idx limit clock clock_max
  printf 'mode:          %s\n' "$(read_value "$STATE_FILE")"
  printf 'no_turbo:      %s\n' "$(read_value "$PSTATE_DIR/no_turbo")"
  printf 'max_perf_pct:  %s\n' "$(read_value "$PSTATE_DIR/max_perf_pct")"
  printf 'governor:      %s (cpu0)\n' "$(read_value "$CPU_DIR/cpu0/cpufreq/scaling_governor")"
  printf 'epp:           %s (cpu0)\n' "$(read_value "$CPU_DIR/cpu0/cpufreq/energy_performance_preference")"
  printf 'rapl PL1:      %s W\n' "$(read_watts "$RAPL_DIR/constraint_0_power_limit_uw")"
  printf 'rapl PL2:      %s W\n' "$(read_watts "$RAPL_DIR/constraint_1_power_limit_uw")"
  if ! query=$("$NVSMI" --query-gpu=index,power.limit,clocks.gr,clocks.max.gr \
      --format=csv,noheader,nounits 2>/dev/null); then
    printf 'gpu:           nvidia-smi unavailable\n'
    return 0
  fi
  while IFS=, read -r idx limit clock clock_max; do
    idx=${idx//[[:space:]]/}
    [[ $idx =~ ^[0-9]+$ ]] || continue
    printf 'gpu %s:         limit %s W, clock %s MHz (max %s)\n' \
      "$idx" "$(whole_number "$limit")" "$(whole_number "$clock")" "$(whole_number "$clock_max")"
  done <<< "$query"
}

main() {
  local arg
  local args=()
  for arg in "$@"; do
    if [[ $arg == --force ]]; then
      FORCE=1
    else
      args+=("$arg")
    fi
  done
  if (( ${#args[@]} != 1 )); then
    usage
    exit 2
  fi
  case ${args[0]} in
    silent|default|turbo)
      take_lock
      apply_requested "${args[0]}"
      ;;
    boot)
      if (( FORCE )); then
        usage
        exit 2
      fi
      take_lock
      boot_mode
      ;;
    status)
      if (( FORCE )); then
        usage
        exit 2
      fi
      show_status
      ;;
    *)
      usage
      exit 2
      ;;
  esac
  if (( FAILED )); then
    exit 1
  fi
}

main "$@"
